{
  "name": "double-blaze",
  "version": "0.1.0",
  "private": true,
  "description": "Double Blaze Solutions platform and customer site runtime.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @double-blaze/platform",
    "dev:sites": "npm run dev -w @double-blaze/sites",
    "build": "npm run build --workspaces --if-present",
    "build:platform": "npm run build -w @double-blaze/platform",
    "build:sites": "npm run build -w @double-blaze/sites",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "prototypes": "npm run prototypes -w @double-blaze/platform",
    "plant-photos": "npm run plant-photos -w @double-blaze/platform",
    "stripe:seed": "npm run stripe:seed -w @double-blaze/platform"
  }
}
