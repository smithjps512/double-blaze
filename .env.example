# Double Blaze platform environment variables.
# Copy to .env.local and fill in. The public marketing storefront builds and
# runs without any of these set; they enable auth, data, and email features.

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Clerk (auth, roles: client / project_lead / admin) ---
# When unset, the app runs in public-only mode (no auth, marketing storefront only).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# --- Supabase (Postgres + RLS) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Resend (transactional email) ---
RESEND_API_KEY=
# Sending and receiving are separate problems. Resend authorizes the From
# address with DNS records and needs no mailbox to send. Replies, though,
# follow MX, and doubleblaze.solutions has no mailbox behind it. Until it does,
# the From address stays on the brand domain and replies go somewhere real.
# All three fall back to the brand address, which currently bounces.
#
# The From address customers see (must be on a Resend-verified domain, so this
# cannot be a gmail.com address):
EMAIL_FROM=
# Where internal notifications land: Trailhead intakes, corrections, storefront
# leads, region interest. Plus-addressing works on Gmail, so a value like
# you+dbleads@gmail.com keeps these filterable:
LEAD_TO_EMAIL=
# Where customer replies land. Defaults to LEAD_TO_EMAIL; set only to split them:
EMAIL_REPLY_TO=
# Signing secret from the Resend webhook endpoint -> /api/webhooks/resend.
# Without it the app knows only whether Resend accepted a message, never
# whether anyone received one, and bounces stay invisible.
RESEND_WEBHOOK_SECRET=

# --- Stripe (Sprint 2 commerce). Use TEST keys (sk_test_/pk_test_) in dev. ---
# STRIPE_SECRET_KEY powers checkout, the webhook, and the stripe:seed script.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Signing secret from the Stripe webhook endpoint -> /api/webhooks/stripe.
STRIPE_WEBHOOK_SECRET=

# --- Anthropic (Spark intake agent) ---
ANTHROPIC_API_KEY=
SPARK_MODEL=claude-sonnet-4-6

# --- Trailhead ---
# Primary domain for subdomain routing. Defaults to doubleblaze.solutions.
# NEXT_PUBLIC_PRIMARY_DOMAIN=doubleblaze.solutions

# --- Members app (apps/members) ---
# Supabase Auth signs in a client's own members. Separate population from
# Clerk, which authenticates Double Blaze staff and client account holders.
# Needs NEXT_PUBLIC_SUPABASE_URL, NEXT_PUBLIC_SUPABASE_ANON_KEY, and
# SUPABASE_SERVICE_ROLE_KEY (already listed above), plus RESEND_API_KEY and
# EMAIL_FROM so sign-in links come from the club's verified domain rather than
# Supabase's default mailer.

# Trail Crew student helper (optional).
# The model answering student questions on the build guides. Defaults to
# claude-opus-5: this one talks to children unattended, and reliably following
# an instruction NOT to answer is exactly what a more capable model does better.
# Lower it only as a deliberate cost decision.
# TRAIL_CREW_HELPER_MODEL=claude-opus-5

# Trail Crew story approvals (optional).
# Where student proposals to change a user story are emailed for approval.
# An env var rather than a literal because this repository is public.
# TRAIL_CREW_TEACHER_EMAIL=you@example.com
#
# Approving a proposal commits the new wording to the repository, which
# triggers a rebuild, which regenerates the team's prototype. Without this
# token the queue still shows proposals and can reject them, but cannot
# approve. Needs contents:write on the repo below.
# GITHUB_TOKEN=
# TRAIL_CREW_REPO_OWNER=smithjps512
# TRAIL_CREW_REPO_NAME=double-blaze
# TRAIL_CREW_REPO_BRANCH=main
